{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadscroll",
  "main": "./src/worker-global.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Worker forwards non-API requests (including SPA deep links) to the
    // assets binding, so it must be exposed as `env.ASSETS`.
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Default name for the provisioned database. The empty database_id marks
      // this as a resource the one-click install should create; the install
      // writes the real id (and can name the database) in the cloned repo.
      "database_name": "leadscroll",
      "database_id": "",
      "migrations_dir": "drizzle"
    }
  ],
  // Native Cloudflare Email Sending binding. Declared by default and invoked
  // only when the saved provider is `cloudflare`; disabled and Resend modes
  // never call or probe it. Additive migration 0004 also ships the durable
  // notification outbox. See docs/email-notifications.md.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    // One bounded notifications tick per minute. It is a no-op while email is
    // disabled and keeps the scheduler warm for an enabled installation.
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
